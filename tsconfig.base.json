{
	"compilerOptions": {
		"declaration": true,
		"esModuleInterop": true,
		"ignoreDeprecations": "6.0",
		"moduleResolution": "node",
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"resolveJsonModule": true,
		"rootDir": "src",
		"strict": true,
		"strictNullChecks": true,
		"types": ["jest", "node"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
